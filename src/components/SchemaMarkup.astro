---
import { serviceLabels, summary, hasPhoto } from '../data/attorneyFacts';
interface Props {
  type: 'attorney' | 'city' | 'organization' | 'website';
  data?: any;
}

const { type, data } = Astro.props;

// Base organization schema that will be included in all pages
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Expungement Attorneys Directory",
  "url": Astro.site?.toString() || "https://www.expungementattorneys.org",
  "logo": new URL("/favicon.svg", Astro.site).toString(),
  "description": "A directory of attorneys who clear criminal records, free legal help by state, and each state's expungement rules in plain English."
};

// Website schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Expungement Attorneys Directory",
  "url": Astro.site?.toString() || "https://www.expungementattorneys.org"
};

// Split "250 E 38th St, Indianapolis, IN 46205" into its parts
function parseAddress(address: string = '') {
  const parts = address.split(',').map(p => p.trim()).filter(Boolean);
  const last = parts[parts.length - 1] || '';
  const m = last.match(/^([A-Z]{2})\s*(\d{5})?/);
  return m && parts.length >= 3
    ? { streetAddress: parts.slice(0, -2).join(', '), addressLocality: parts[parts.length - 2], addressRegion: m[1], postalCode: m[2] || undefined, addressCountry: 'US' }
    : { streetAddress: address, addressCountry: 'US' };
}

// Generate attorney schema (no star ratings: the ratings are not collected by this site)
function generateAttorneySchema(attorney: any) {
  if (!attorney) return null;
  const services = serviceLabels(attorney, 12);
  const site = attorney.website && attorney.website !== '#' ? attorney.website : undefined;
  return {
    "@context": "https://schema.org",
    "@type": "LegalService",
    "@id": new URL(`/attorneys/${attorney.slug}`, Astro.site).toString(),
    "name": attorney.name,
    ...(hasPhoto(attorney) ? { "image": new URL(attorney.image, Astro.site).toString() } : {}),
    "description": summary(attorney, 250) || `${attorney.name} is a law firm in ${attorney.city}, ${attorney.state} that handles expungement and record sealing cases.`,
    ...(attorney.phone ? { "telephone": attorney.phone } : {}),
    ...(site ? { "url": site, "sameAs": [site] } : {}),
    "address": { "@type": "PostalAddress", ...parseAddress(attorney.address) },
    "areaServed": { "@type": "State", "name": attorney.state },
    ...(services.length ? { "knowsAbout": services } : {}),
    ...(attorney.profile?.languages?.length ? { "knowsLanguage": ['English', ...attorney.profile.languages.filter((l: string) => !/english/i.test(l))] } : {})
  };
}

// City page: the list of firms on the page
function generateCitySchema(city: any) {
  if (!city) return null;
  const items = (city.listings || []) as any[];
  return {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": `Expungement attorneys in ${city.name}, ${city.state}`,
    "numberOfItems": items.length,
    "itemListElement": items.map((a, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": new URL(`/attorneys/${a.slug}`, Astro.site).toString(),
      "name": a.name
    }))
  };
}

// Determine which schema to use based on the type
let schema;
switch (type) {
  case 'attorney':
    schema = generateAttorneySchema(data);
    break;
  case 'city':
    schema = generateCitySchema(data);
    break;
  case 'organization':
    schema = organizationSchema;
    break;
  case 'website':
    schema = websiteSchema;
    break;
  default:
    schema = null;
}
---

{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}

{type === 'website' && (
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
)} 