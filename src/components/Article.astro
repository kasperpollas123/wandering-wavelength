---
// A researched guide page, rendered from src/data/articles.json, following the editorial standard
// (byline, Key Takeaways, warm opening, contents, question headings, bold key line, charts, Next Steps).
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import GuideIntro from './GuideIntro.astro';
import NextSteps from './NextSteps.astro';
import BarChart from './BarChart.astro';
import Steps from './Steps.astro';
import articles from '../data/articles.json';
import { guideTopics } from '../data/guides';
import { attorneys } from '../data/attorneys';
import { serviceLabels } from '../data/attorneyFacts';
import recordChecks from '../data/recordChecks.json';
import cfpb from '../data/cfpbComplaints.json';
import duiFelony from '../data/duiFelony.json';
import { stateNames, stateSlug } from '../data/cities';

interface Props { slug: string; }
const { slug } = Astro.props;
const article = (articles as any[]).find(a => a.slug === slug);
if (!article) throw new Error(`No article data for ${slug}`);
const otherArticles = (articles as any[]).filter(a => a.slug !== slug);
const checked = 'November 2026';

const idOf = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);
const sections = article.sections.map((s: any) => ({
  ...s,
  title: article.headings?.[s.heading] || s.heading,
  key: article.keys?.[s.heading] || null,
  keyInText: Boolean(article.keys?.[s.heading] && (s.paragraphs || []).some((p: string) => p.includes(article.keys[s.heading]))),
  id: idOf(article.headings?.[s.heading] || s.heading),
}));
const showRecordChecks = slug === 'how-to-get-a-copy-of-your-criminal-record';
const showComplaints = slug === 'expunged-record-showing-on-background-check';
const showDui = slug === 'is-a-dui-a-felony';
const duiRows = showDui ? [...(duiFelony as any[])].filter(d => stateNames[d.state]).sort((a, b) => stateNames[a.state].localeCompare(stateNames[b.state])) : [];
const felonyAt: Record<string, string> = article.felony_at || {};
const atCount = (k: string) => duiRows.filter(d => felonyAt[d.state] === k).length;
const cfpbMax = Math.max(...cfpb.companies.flatMap(c => c.counts));
const checks = showRecordChecks ? [...(recordChecks as any[])].filter(c => stateNames[c.state]).sort((a, b) => stateNames[a.state].localeCompare(stateNames[b.state])) : [];
const fpKind = (f: string) => /^required/i.test(f) ? 'required' : /^not required/i.test(f) ? 'not' : /^optional/i.test(f) ? 'optional' : 'depends';
const fpCount = (k: string) => checks.filter(c => fpKind(c.fingerprints || '') === k).length;
const toc = [...sections.map((s: any) => ({ id: s.id, label: s.title })), ...(showRecordChecks ? [{ id: 'every-state', label: 'How to Get Your Record in Every State' }] : []), ...(showDui ? [{ id: 'every-state', label: 'DUI and Felony Rules in Every State' }] : []), ...(showComplaints ? [{ id: 'complaints', label: 'How Often Do People Complain About Background Check Companies?' }] : []), ...(article.next_steps?.length ? [{ id: 'next-steps', label: 'Next Steps' }] : [])];
const words = JSON.stringify(article).split(/\s+/).length;
const minutes = Math.max(3, Math.round(words / 230));

// Charts built only from facts already on the page
const splitStep = (b: string) => { const i = b.search(/[:.] /); return i > 0 && i < 80 ? { label: b.slice(0, i), detail: b.slice(i + 2) } : { label: b.split(' ').slice(0, 6).join(' ') + '…', detail: b }; };
const charts: Record<string, any> = {};
if (slug === 'how-to-remove-an-eviction-from-your-record') {
  charts['State laws that seal or limit eviction records'] = { type: 'bars', title: 'How the 19 laws in this guide clear eviction records', source: 'Count of the laws in the table below (18 states and DC), as each law is written. Checked November 2026.',
    rows: [{ label: 'Seal at least some cases automatically', value: 12, tone: 'green' }, { label: 'Only when the tenant asks the court', value: 3, tone: 'amber' }, { label: 'The law does not say how', value: 4, tone: 'gray' }] };
}
if (slug === 'expunged-record-showing-on-background-check') {
  const d = article.sections.find((s: any) => s.heading === 'The dispute steps');
  if (d) charts['The dispute steps'] = { type: 'steps', title: 'Fixing an expunged record on a background check, step by step', source: 'Steps as described by the CFPB and FTC (sources at the end).', steps: d.bullets.map(splitStep) };
}
if (slug === 'restoring-gun-rights-after-a-conviction') {
  const d = article.sections.find((s: any) => s.heading === 'The federal application process reopened in 2026');
  if (d) charts['The federal application process reopened in 2026'] = { type: 'steps', title: 'The federal application, as the 2026 rule describes it', source: 'From the 2026 federal rule (sources at the end).', steps: d.bullets.map(splitStep) };
}
// Live directory facts
const gunFirms = attorneys.filter(a => serviceLabels(a, 12).includes('Gun rights')).length;
---

<PageLayout title={article.title} description={article.description} canonicalURL={`/guides/${article.slug}`} schemaType="article" schemaData={{ title: article.title, description: article.description, url: `/guides/${article.slug}` }}>
  <div class="container py-6">
    <Breadcrumbs items={[{ label: "Guides", href: "/guides" }, { label: article.nav }]} />
  </div>

  <section class="pb-12 bg-white">
    <div class="container">
      <article class="max-w-3xl mx-auto pt-4">
        <GuideIntro title={article.title} lede={article.lede || article.intro} takeaways={article.takeaways || []} toc={toc} minutes={minutes} />
        <p class="text-sm text-gray-500 mb-10">{`Checked ${checked} against the sources listed at the end. General information, not legal advice; laws change and the details of a case matter. `}<a href="/about" class="underline">How we research</a></p>

        {sections.map((s: any) => (
          <section id={s.id} class="mb-12 scroll-mt-24">
            <h2 class="!text-2xl font-bold !mb-4">{s.title}</h2>
            {s.key && !s.keyInText && <p class="text-[18px] font-semibold text-gray-900 mb-4 border-l-4 border-secondary pl-4">{s.key}</p>}
            {(s.paragraphs || []).map((p: string) => {
              const i = s.key ? p.indexOf(s.key) : -1;
              return i >= 0
                ? <p class="text-[17px] leading-relaxed text-gray-700 mb-4">{p.slice(0, i)}<strong class="text-gray-900">{s.key}</strong>{p.slice(i + s.key.length)}</p>
                : <p class="text-[17px] leading-relaxed text-gray-700 mb-4">{p}</p>;
            })}
            {charts[s.heading]?.type === 'steps' ? (
              <Steps title={charts[s.heading].title} steps={charts[s.heading].steps} source={charts[s.heading].source} />
            ) : s.bullets && s.bullets.length > 0 && (
              <ul class="list-disc pl-6 text-[17px] text-gray-700 space-y-2 mb-4">
                {s.bullets.map((b: string) => <li>{b}</li>)}
              </ul>
            )}
            {charts[s.heading]?.type === 'bars' && <BarChart title={charts[s.heading].title} rows={charts[s.heading].rows} source={charts[s.heading].source} />}
            {s.table && (
              <div class="overflow-x-auto mb-4 rounded-lg border border-gray-200">
                <table class="w-full text-left text-sm">
                  <thead class="bg-gray-50">
                    <tr>{s.table.headers.map((h: string) => <th class="p-3 border-b border-gray-200">{h}</th>)}</tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((row: string[]) => (
                      <tr class="border-b border-gray-100 align-top">
                        {row.map((cell: string, i: number) => <td class={`p-3 text-gray-700 ${i === 0 ? `font-medium ${cell.length < 22 ? 'whitespace-nowrap' : 'min-w-[9rem]'}` : 'min-w-[10rem]'}`}>{cell}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {slug === 'restoring-gun-rights-after-a-conviction' && s.heading === 'How state restoration works in ten states' && gunFirms > 0 && (
              <p class="rounded-lg bg-gray-50 border border-gray-200 p-4 text-[15px] text-gray-700">{`In our directory, ${gunFirms} law firms say on their own websites that they handle firearm rights restoration. `}<a href="/states" class="text-secondary font-semibold">Find attorneys by state →</a></p>
            )}
          </section>
        ))}

        {showDui && (
          <section id="every-state" class="mb-12 scroll-mt-24">
            <h2 class="!text-2xl font-bold !mb-4">DUI and Felony Rules in Every State</h2>
            <BarChart title="When a repeat DUI alone becomes a felony: number of states" rows={[{ label: 'Second offense', value: atCount('2nd'), tone: 'red' }, { label: 'Third offense', value: atCount('3rd'), tone: 'amber' }, { label: 'Fourth offense', value: atCount('4th'), tone: 'blue' }, { label: 'Fifth offense or later', value: atCount('5th or later'), tone: 'green' }, { label: 'Never on repeat offenses alone', value: atCount('never (repeat offenses alone)'), tone: 'gray' }, { label: 'Unclear from the law we read', value: atCount('unclear'), tone: 'gray' }]} source="Out of 50 states and DC, from each state's DUI statute (look-back periods differ; details below). Injury, death, a child passenger or other factors can make a DUI a felony sooner. Checked November 2026." />
            <div class="space-y-4">
              {duiRows.map(d => (
                <div id={`dui-${stateSlug(d.state)}`} class="rounded-xl border border-gray-200 p-5 scroll-mt-24">
                  <h3 class="!text-lg font-bold !mb-2">{`${stateNames[d.state]}${d.term ? ` (${d.term})` : ''}`}</h3>
                  <dl class="text-[15px] space-y-1.5">
                    {d.first_offense && <div><dt class="inline font-semibold">First offense: </dt><dd class="inline text-gray-700">{d.first_offense}</dd></div>}
                    {d.felony_when && <div><dt class="inline font-semibold">Becomes a felony: </dt><dd class="inline text-gray-700">{d.felony_when}</dd></div>}
                    {d.other_felony && d.other_felony.length > 0 && <div><dt class="inline font-semibold">Also a felony: </dt><dd class="inline text-gray-700">{d.other_felony.join('; ')}</dd></div>}
                  </dl>
                  <p class="text-sm mt-3">
                    {d.url && <a href={d.url} target="_blank" rel="noopener noreferrer" class="underline text-gray-600">{d.citation || 'Statute'}</a>}
                    <span>{' · '}</span><a href={`/states/${stateSlug(d.state)}`} class="text-secondary font-semibold">{`Clearing a record in ${stateNames[d.state]}`}</a>
                  </p>
                  {d.confidence !== 'high' && <p class="text-xs text-gray-500 mt-2">{d.confidence === 'low' ? 'We could not read the current official text; check with a local attorney or the court.' : 'Based on an official summary or older statute text; recent changes may not be reflected.'}</p>}
                </div>
              ))}
            </div>
          </section>
        )}

        {showComplaints && (
          <section id="complaints" class="mb-12 scroll-mt-24">
            <h2 class="!text-2xl font-bold !mb-4">How Often Do People Complain About Background Check Companies?</h2>
            <p class="text-[17px] leading-relaxed text-gray-700 mb-4">The Consumer Financial Protection Bureau keeps a public database of complaints about consumer reporting companies. <strong class="text-gray-900">{`From ${cfpb.publicRecordInaccurate.from} to ${cfpb.publicRecordInaccurate.to}, it received ${cfpb.publicRecordInaccurate.count.toLocaleString('en-US')} complaints in the category "public record information inaccurate".`}</strong> Most were about the three big credit bureaus, but employment screening companies are in there too, and complaints about three of the four below have risen sharply since 2024.</p>
            <figure class="rounded-xl border border-gray-200 p-5 my-6">
              <figcaption class="font-bold text-gray-900 mb-4">All complaints to the CFPB about four background check companies, by year</figcaption>
              <div class="space-y-5">
                {cfpb.companies.map(c => (
                  <div>
                    <p class="text-sm font-semibold text-gray-900 mb-2">{c.name}</p>
                    <div class="space-y-1">
                      {c.counts.map((n, i) => (
                        <div class="flex items-center gap-2 text-xs text-gray-600">
                          <span class="w-10 shrink-0">{`${cfpb.years[i]}${cfpb.years[i] === 2026 ? '*' : ''}`}</span>
                          <span class="h-2.5 rounded-full bg-sky-500" style={`width:${Math.max(1, Math.round((n / cfpbMax) * 70))}%`}></span>
                          <span>{n}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
              <p class="text-xs text-gray-500 mt-4">{`*2026 is January 1 to November 20. These are all complaints about each company, not only about expunged records. Counts from the CFPB Consumer Complaint Database (public domain), retrieved ${cfpb.retrieved}. A complaint is one person's account; the CFPB does not verify every claim. `}<a href={cfpb.source} target="_blank" rel="noopener noreferrer" class="underline">Search the database</a></p>
            </figure>
            <p class="text-[17px] leading-relaxed text-gray-700">If an expunged or sealed record shows up on your report and the company won't fix it after a dispute, you can also file a complaint of your own at <a href="https://www.consumerfinance.gov/complaint/" target="_blank" rel="noopener noreferrer" class="text-secondary font-semibold">consumerfinance.gov/complaint</a>.</p>
          </section>
        )}

        {showRecordChecks && (
          <section id="every-state" class="mb-12 scroll-mt-24">
            <h2 class="!text-2xl font-bold !mb-4">How to Get Your Record in Every State</h2>
            <p class="text-[17px] leading-relaxed text-gray-700 mb-4">Each state keeps its own central criminal record, separate from the FBI's. Here is the agency in every state, what it calls the check, how to ask for it and what it charges to see your own record.</p>
            <BarChart title="Do you need fingerprints to see your own state record?" rows={[{ label: 'Yes', value: fpCount('required'), tone: 'amber' }, { label: 'No', value: fpCount('not'), tone: 'green' }, { label: 'Optional', value: fpCount('optional'), tone: 'blue' }, { label: 'Depends on the type of check', value: fpCount('depends'), tone: 'gray' }]} source="Out of 50 states and DC, from each state agency's own pages. Checked November 2026." />
            <div class="space-y-4">
              {checks.map(c => (
                <div id={`record-${stateSlug(c.state)}`} class="rounded-xl border border-gray-200 p-5 scroll-mt-24">
                  <h3 class="!text-lg font-bold !mb-1">{stateNames[c.state]}</h3>
                  <p class="text-sm text-gray-600 mb-2">{`${c.agency}${c.check_name ? ` · ${c.check_name}` : ''}`}</p>
                  <dl class="text-[15px] space-y-1.5">
                    <div><dt class="inline font-semibold">How to ask: </dt><dd class="inline text-gray-700">{c.how}</dd></div>
                    <div><dt class="inline font-semibold">Fingerprints: </dt><dd class="inline text-gray-700">{c.fingerprints}</dd></div>
                    <div><dt class="inline font-semibold">Fee: </dt><dd class="inline text-gray-700">{c.fee === '$0' ? 'Free' : (c.fee || 'Not confirmed on an official page; ask the agency')}</dd></div>
                  </dl>
                  <p class="text-sm mt-3">
                    {c.url && <a href={c.url} target="_blank" rel="noopener noreferrer" data-track="record-check" class="text-secondary font-semibold">Official page →</a>}
                    <span>{c.url ? ' · ' : ''}</span><a href={`/states/${stateSlug(c.state)}`} class="text-secondary font-semibold">{`Clearing a record in ${stateNames[c.state]}`}</a>
                  </p>
                  {c.confidence === 'low' && <p class="text-xs text-gray-500 mt-2">We could not confirm all of this on a current official page; check with the agency.</p>}
                </div>
              ))}
            </div>
          </section>
        )}

        <NextSteps steps={article.next_steps || []} />

        <div class="p-6 rounded-xl border border-gray-200 mb-10">
          <h2 class="!text-xl font-semibold !mb-3">Where to get help</h2>
          <ul class="space-y-2">
            <li><a href="/free-expungement-help" class="text-primary hover:underline">Free and low-cost legal help by state</a></li>
            <li><a href="/states" class="text-primary hover:underline">Each state's record-clearing rules, costs and attorneys</a></li>
            {article.slug === 'expunged-record-showing-on-background-check' && (
              <li><a href="https://www.consumeradvocates.org/findanattorney/" target="_blank" rel="noopener noreferrer" data-track="naca" class="text-primary hover:underline">National Association of Consumer Advocates: find a consumer attorney by state (filter by credit reporting)</a></li>
            )}
          </ul>
        </div>

        <div class="mb-10">
          <h2 class="!text-xl font-semibold !mb-3">Sources</h2>
          <ul class="text-sm text-gray-600 space-y-1">
            {article.sources.map((src: any) => <li><a href={src.url} target="_blank" rel="noopener noreferrer" class="underline">{src.label}</a></li>)}
          </ul>
        </div>

        <div class="p-6 rounded-xl border border-gray-200">
          <h2 class="!text-xl font-semibold !mb-3">Related guides</h2>
          <ul class="space-y-2">
            {otherArticles.map((a: any) => <li><a href={`/guides/${a.slug}`} class="text-primary hover:underline">{a.title}</a></li>)}
            {guideTopics.map(t => <li><a href={`/guides/${t.slug}`} class="text-primary hover:underline">{t.title}</a></li>)}
            <li><a href="/guides/expungement-cost-by-state" class="text-primary hover:underline">How Much Does an Expungement Cost? Fees in Every State</a></li>
          </ul>
        </div>
      </article>
    </div>
  </section>
</PageLayout>
