---
// Listing card, modelled on the adult day care directory's cards: enough facts to decide without clicking.
import type { Attorney } from '../data/attorneys';
import { badges, BADGE_CLASS, serviceLabels, initials, hasPhoto, telHref, prettyPhone, prettyHost } from '../data/attorneyFacts';

interface Props { attorney: Attorney; }
const { attorney: a } = Astro.props;

const tags = badges(a);
const services = serviceLabels(a);
const text = a.cardText || '';
const photo = hasPhoto(a);
const hasWebsite = a.website && a.website !== '#';
const profileUrl = `/attorneys/${a.slug}`;
---

<article class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden flex flex-col">
  <a href={profileUrl} class="block no-underline-fx" aria-label={`${a.name} details`}>
    {photo ? (
      <img src={a.image} alt={a.name} class="w-full h-44 object-cover bg-slate-100" loading="lazy" decoding="async" width="400" height="176"
        onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';" />
    ) : null}
    <div class={`${photo ? 'hidden' : 'flex'} w-full h-28 items-center justify-center bg-gradient-to-br from-slate-100 to-blue-50`}>
      <span class="w-14 h-14 rounded-full bg-white border border-blue-100 flex items-center justify-center text-lg font-bold text-secondary">{initials(a.name)}</span>
    </div>
  </a>

  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-start justify-between gap-3">
      <h3 class="!mb-0 text-lg font-bold leading-snug text-gray-900"><a href={profileUrl} class="hover:text-secondary">{a.name}</a></h3>
      {a.reviewCount > 0 && (
        <span class="shrink-0 inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-sm font-semibold text-amber-900" title={`${a.rating} out of 5 from ${a.reviewCount} reviews`}>
          <svg class="h-3.5 w-3.5 text-amber-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12L2.07 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 00.95-.69l1.07-3.29z"/></svg>
          {a.rating}<span class="font-normal text-amber-800">{` (${a.reviewCount})`}</span>
        </span>
      )}
    </div>

    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.map(t => <span class={`rounded-full border px-2.5 py-0.5 text-xs font-medium ${BADGE_CLASS[t.tone]}`}>{t.label}</span>)}
      </div>
    )}

    {services.length > 0 && (
      <div class="mt-4">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-gray-500">Records they clear</p>
        <p class="mt-1 text-sm text-gray-800">{services.join(' · ')}</p>
      </div>
    )}

    {text && <p class="mt-3 text-[15px] leading-relaxed text-gray-700">{text}</p>}

    <ul class="mt-4 space-y-2 text-sm text-gray-600">
      {a.address && (
        <li class="flex gap-2"><svg class="h-4 w-4 mt-0.5 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.66 16.66L13.41 20.9a2 2 0 01-2.83 0l-4.24-4.24a8 8 0 1111.32 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg><span>{a.address}</span></li>
      )}
      {a.phone && (
        <li class="flex gap-2"><svg class="h-4 w-4 mt-0.5 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.95.68l1.5 4.5a1 1 0 01-.5 1.21l-2.26 1.13a11 11 0 005.52 5.52l1.13-2.26a1 1 0 011.21-.5l4.5 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z"/></svg><a href={telHref(a.phone)} data-track="card" class="text-gray-700">{prettyPhone(a.phone)}</a></li>
      )}
      {hasWebsite && (
        <li class="flex gap-2"><svg class="h-4 w-4 mt-0.5 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg><a href={a.website} target="_blank" rel="noopener noreferrer" data-track="card" class="text-secondary break-all">{prettyHost(a.website)}</a></li>
      )}
    </ul>

    <div class="pt-5 grid gap-2 mt-auto">
      {a.phone ? (
        <a href={telHref(a.phone)} data-track="card-button" class="btn btn-primary w-full !py-2.5 !shadow-sm hover:!translate-y-0">Call {prettyPhone(a.phone)}</a>
      ) : hasWebsite ? (
        <a href={a.website} target="_blank" rel="noopener noreferrer" data-track="card-button" class="btn btn-primary w-full !py-2.5 !shadow-sm hover:!translate-y-0">Visit website</a>
      ) : null}
      <a href={profileUrl} class="btn w-full !py-2.5 bg-white text-gray-800 border-gray-300 !shadow-none hover:!translate-y-0 hover:bg-gray-50">View details →</a>
    </div>
  </div>
</article>
