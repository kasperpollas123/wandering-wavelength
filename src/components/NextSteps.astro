---
interface Props { steps: string[]; }
const { steps } = Astro.props;
// Turn "/states" style paths in a step into links
const linkify = (s: string) => s.replace(/(\/(?:states|free-expungement-help|guides|cities)[a-z0-9\-\/]*)/g, '<a href="$1" class="text-secondary font-semibold">$1</a>');
---
{steps.length > 0 && (
  <div id="next-steps" class="rounded-xl border border-blue-200 bg-blue-50 p-6 my-10 scroll-mt-24">
    <h2 class="!text-2xl font-bold !mb-4">Next Steps</h2>
    <ol class="space-y-3">
      {steps.map((s, i) => (
        <li class="flex gap-3"><span class="shrink-0 w-7 h-7 rounded-full bg-secondary text-white text-sm font-bold flex items-center justify-center">{i + 1}</span><span class="text-[16px] text-gray-800 pt-0.5" set:html={linkify(s.replace(/&/g, '&amp;').replace(/</g, '&lt;'))} /></li>
      ))}
    </ol>
  </div>
)}
