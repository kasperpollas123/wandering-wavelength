---
import '../styles/base.css';
import SchemaMarkup from '../components/SchemaMarkup.astro';

interface Props {
	title: string;
	description: string;
	canonicalURL?: string;
	schemaType?: 'attorney' | 'city' | 'organization' | 'website';
	schemaData?: any;
	noindex?: boolean;
}

const { 
	title, 
	description, 
	canonicalURL = Astro.url.pathname,
	schemaType = 'website',
	schemaData,
	noindex = false
} = Astro.props;

const fullCanonicalURL = new URL(canonicalURL, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#0f2a4a" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		
		<!-- Canonical URL -->
		<link rel="canonical" href={fullCanonicalURL} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={fullCanonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL("/images/hero/p8bsykcxvdrme0cn7wer7hzwfm.jpeg", Astro.site)} />
		<meta property="og:site_name" content="Expungement Attorneys Directory" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={new URL("/images/hero/p8bsykcxvdrme0cn7wer7hzwfm.jpeg", Astro.site)} />
		<meta property="twitter:url" content={fullCanonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		
		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" as="style">
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		</noscript>
		
		
		<!-- Preload critical images -->
		<link rel="preload" href="/images/hero/p8bsykcxvdrme0cn7wer7hzwfm.webp" as="image" type="image/webp" fetchpriority="high">
		
		<!-- Schema Markup -->
		<SchemaMarkup type={Astro.props.schemaType || 'website'} data={Astro.props.schemaData} />
		
		<!-- Microsoft Clarity -->
		<script type="text/javascript">
			(function(c,l,a,r,i,t,y){
				c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
				t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
				y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
			})(window, document, "clarity", "script", "sguojf94k3");
		</script>
	</head>
	<body>
		<slot />
		
		<!-- First-party visit statistics: page views, time on page and clicks on phone, website and
		     free-help links. No cookies and nothing personal: a random ID per browser tab.
		     Visit /?exp_notrack=1 once to exclude your own browser. -->
		<script is:inline>
			(function () {
				try {
					var host = location.hostname;
					if (host === 'localhost' || host === '127.0.0.1' || navigator.webdriver) return;
					var q = new URLSearchParams(location.search), flag = q.get('exp_notrack');
					if (flag === '1') localStorage.setItem('exp_notrack', '1');
					if (flag === '0') localStorage.removeItem('exp_notrack');
					if (localStorage.getItem('exp_notrack') === '1') return;
					// Where the statistics are sent (a receiver on the sister site; stored apart from that site's own figures)
					var URL_ = 'https://www.adultdaycarecenters.org/site/x';
					var id = function () { try { return crypto.randomUUID(); } catch (e) { return Math.random().toString(36).slice(2) + Date.now().toString(36); } };
					var visit = '', entry = false;
					try { visit = sessionStorage.getItem('exp_visit') || ''; if (!visit) { visit = id(); sessionStorage.setItem('exp_visit', visit); entry = true; } } catch (e) { visit = id(); entry = true; }
					var page = id();
					var send = function (d) {
						try {
							d.visit_id = visit; d.page_id = page; d.path = location.pathname;
							fetch(URL_ + '?d=' + encodeURIComponent(JSON.stringify(d)), { mode: 'no-cors', keepalive: true, credentials: 'omit' }).catch(function () {});
						} catch (e) {}
					};
					var ref = '';
					try { if (document.referrer) { var u = new URL(document.referrer); if (u.host !== location.host) ref = u.origin + u.pathname; } } catch (e) {}
					send({ kind: 'view', entry: entry, referrer: ref, campaign: q.get('ref') || '', utm: q.get('utm_source') || '' });
					var since = document.visibilityState === 'visible' ? Date.now() : 0, ms = 0;
					var flush = function () { if (since) { ms += Date.now() - since; since = 0; } var s = Math.round(ms / 1000); if (s >= 1) { send({ kind: 'time', seconds: Math.min(s, 1800) }); ms = 0; } };
					document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden') flush(); else if (!since) since = Date.now(); });
					window.addEventListener('pagehide', flush);
					document.addEventListener('click', function (e) {
						var a = e.target && e.target.closest ? e.target.closest('a[href]') : null; if (!a) return;
						var href = a.getAttribute('href') || '', where = a.getAttribute('data-track') || '';
						if (href.indexOf('tel:') === 0) send({ kind: 'action', action: 'phone_click', placement: where });
						else if (/^https?:/.test(href) && a.host !== location.host) send({ kind: 'action', action: location.pathname.indexOf('/free-expungement-help') === 0 ? 'help_click' : 'website_click', placement: where || a.host.replace(/^www\./, '').slice(0, 55) });
					}, true);
				} catch (e) {}
			})();
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
