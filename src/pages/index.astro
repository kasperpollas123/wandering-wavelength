---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import FAQSection from '../components/FAQSection.astro';
import { cities } from '../data/cities';
import { getAttorneysForCity, attorneys, getAttorneysByState } from '../data/attorneys';
import { stateNames, stateSlug } from '../data/cities';
import { helpStates } from '../data/freeHelp';
import { guideTopics } from '../data/guides';
import articles from '../data/articles.json';

// Calculate actual attorney counts for each city
const citiesWithActualCounts = cities.map(city => {
  const attorneys = getAttorneysForCity(city);
  return {
    ...city,
    attorneyCount: attorneys.length
  };
});

const states = Object.keys(stateNames)
  .map(code => ({ code, name: stateNames[code], count: getAttorneysByState(code).length }))
  .sort((a, b) => a.name.localeCompare(b.name));
const helpTotal = helpStates.reduce((n, st) => n + st.count, 0);

// Cities with the most listed attorneys
const topCities = citiesWithActualCounts.filter(c => c.attorneyCount > 0)
  .sort((a, b) => b.attorneyCount - a.attorneyCount)
  .slice(0, 12);
const guides = [{ slug: 'expungement-cost-by-state', title: 'How Much Does an Expungement Cost? Fees in Every State', description: 'Court and state fees to clear a record in every state, fee waivers, and free automatic clearing.' }, ...guideTopics.map(t => ({ slug: t.slug, title: t.title, description: t.description })), ...(articles as any[]).map(a => ({ slug: a.slug, title: a.title, description: a.description }))];
const titleCase = (s: string) => s.split(' ').map(w => w ? w[0].toUpperCase() + w.slice(1) : w).join(' ');
---

<PageLayout 
  title="Expungement Attorneys and Free Legal Help by State"
  description={`Find attorneys who clear criminal records in ${states.length} states, free legal aid and clinics in every state, and each state's expungement rules in plain English.`}
>
  <Hero 
    title="Clear Your Criminal Record"
    subtitle={`${attorneys.length} attorneys in ${states.length} states who handle expungement and record sealing, ${helpTotal} free legal aid programmes, and each state's rules in plain English.`}
    showSearch={false}
    backgroundImage="/images/hero/p8bsykcxvdrme0cn7wer7hzwfm.webp"
  />

  <section class="py-12 md:py-16 bg-white">
    <div class="container max-w-5xl">
      <h2 class="!text-3xl !mb-2 text-center">Expungement Attorneys by City</h2>
      <p class="text-lg text-gray-600 text-center mb-8">Each firm's listing shows what it can clear, whether the first consultation is free, and how to call.</p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {topCities.map(c => (
          <a href={`/cities/${c.seoSlug || c.slug}`} class="flex items-center justify-between rounded-xl border border-gray-200 bg-white px-5 py-4 hover:border-secondary transition-colors">
            <span>
              <span class="block text-lg font-bold text-gray-900">{titleCase(c.name)}</span>
              <span class="block text-sm text-gray-500">{stateNames[c.state] || c.state}</span>
            </span>
            <span class="text-right">
              <span class="block text-2xl font-bold text-secondary leading-none">{c.attorneyCount}</span>
              <span class="block text-xs text-gray-500 mt-1">attorneys</span>
            </span>
          </a>
        ))}
      </div>
      <div class="mt-6 text-center"><a href="/cities" class="text-secondary font-semibold">All cities →</a></div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-gray-50 border-y border-gray-200">
    <div class="container max-w-5xl">
      <h2 class="!text-3xl !mb-2 text-center">Rules and Free Help by State</h2>
      <p class="text-lg text-gray-600 text-center mb-8">What can be cleared, how long you wait, what it is called in your state, and attorneys and free legal aid there.</p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {states.map(st => (
          <a href={`/states/${stateSlug(st.code)}`} class="flex items-center justify-between px-4 py-3 rounded-lg border border-gray-200 bg-white hover:border-secondary transition-colors">
            <span class="font-medium">{st.name}</span>
            {st.count > 0 && <span class="text-sm text-gray-500">{`${st.count}`}</span>}
          </a>
        ))}
      </div>
      <a href="/free-expungement-help" class="mt-8 block rounded-xl border border-emerald-200 bg-emerald-50 p-5 hover:border-emerald-400 transition-colors">
        <span class="block text-lg font-bold text-emerald-900">Can't afford an attorney?</span>
        <span class="block text-emerald-900/80 mt-1">{`${helpTotal} legal aid offices, law school clinics and court programmes that help for free, with who qualifies for each →`}</span>
      </a>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="container max-w-5xl">
      <h2 class="!text-3xl !mb-8 text-center">Guides</h2>
      <div class="grid gap-3 md:grid-cols-2">
        {guides.map(g => (
          <a href={`/guides/${g.slug}`} class="block rounded-xl border border-gray-200 bg-white p-5 hover:border-secondary transition-colors">
            <span class="block font-bold text-gray-900">{g.title}</span>
            <span class="block text-sm text-gray-600 mt-1">{g.description}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FAQSection limit={4} />
</PageLayout>
