---
import PageLayout from '../../layouts/PageLayout.astro';
import AttorneyCard from '../../components/AttorneyCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { cities, stateNames, stateSlug } from '../../data/cities';
import { getAttorneysForCity } from '../../data/attorneys';
import { listingOrder, otherLanguages, isFormerProsecutor } from '../../data/attorneyFacts';
import { getHelpForState } from '../../data/freeHelp';
import RelatedGuides from '../../components/RelatedGuides.astro';

export function getStaticPaths() {
  return cities.filter(city => getAttorneysForCity(city).length > 0).map(city => ({
    params: { slug: city.seoSlug || city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;

// Use the base slug (not SEO slug) for fetching attorneys
const attorneys = getAttorneysForCity(city);
const stateName = stateNames[city.state] || city.state;
const helpOrgs = getHelpForState(city.state);
const helpCount = helpOrgs.length;
// Free programmes that name this city in their area or name (statewide ones are on the state's free help page)
const cityRe = new RegExp(`\\b${city.name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`, 'i');
const localHelp = helpOrgs.filter(o => cityRe.test(`${o.area_served || ''} ${o.name}`)).slice(0, 4);

// Format city name for display (capitalize first letter of each word)
const formatCityName = (name: string) => {
  return name.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
};

const cityName = formatCityName(city.name);

// Facts about this city's listings, taken from the firms' own profiles
const sorted = [...attorneys].sort(listingOrder);
const freeConsult = attorneys.filter(a => a.profile?.free_consultation === true).length;
const spanish = attorneys.filter(a => otherLanguages(a).includes('Spanish')).length;
const prosecutors = attorneys.filter(isFormerProsecutor).length;
const n = attorneys.length;
const intro = `${n} ${n === 1 ? 'law firm' : 'law firms'} in ${cityName} that ${n === 1 ? 'handles' : 'handle'} expungement and record sealing. Each listing shows what the firm says it can clear, whether the first consultation is free, and how to reach it.`;
const statLine = [
  freeConsult > 0 && { n: freeConsult, label: 'offer a free consultation' },
  spanish > 0 && { n: spanish, label: spanish === 1 ? 'speaks Spanish' : 'speak Spanish' },
  prosecutors > 0 && { n: prosecutors, label: prosecutors === 1 ? 'former prosecutor' : 'former prosecutors' },
].filter(Boolean) as { n: number; label: string }[];
const metaDescription = `${attorneys.length} expungement and record sealing ${attorneys.length === 1 ? 'attorney' : 'attorneys'} in ${cityName}, ${city.state}${freeConsult > 0 ? `, ${freeConsult} with a free consultation` : ''}. What each one clears, languages and phone numbers.`;


// Concise meta description within 155 characters

// Find nearby cities in the same state (excluding current city)
const nearbyCitiesWithCounts = cities
  .filter(c => c.state === city.state && c.slug !== city.slug)
  .map(c => {
    const cityAttorneys = getAttorneysForCity(c);
    return {
      ...c,
      attorneyCount: cityAttorneys.length
    };
  })
  .sort((a, b) => b.attorneyCount - a.attorneyCount) // Sort by attorney count
  .filter(c => c.attorneyCount > 0)
  .slice(0, 8);
---

<PageLayout 
  title={`Expungement Attorneys in ${city.name}, ${city.state} | Record Clearing Lawyers`}
  description={metaDescription}
  canonicalURL={`/cities/${city.seoSlug || city.slug}`}
  schemaType="city"
  schemaData={{ ...city, listings: sorted }}
>
  <!-- Add Schema.org markup for City -->
  
  <section class="bg-white border-b border-gray-200">
    <div class="container pt-6 pb-8">
      <Breadcrumbs 
        items={[
          { label: stateName, href: `/states/${stateSlug(city.state)}` },
          { label: `${cityName}, ${city.state}` }
        ]}
      />
      <h1 class="!text-3xl md:!text-4xl !mb-3 mt-4">Expungement Attorneys in {cityName}, {city.state}</h1>
      <p class="text-lg text-gray-700 max-w-3xl">{intro}</p>
      {statLine.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {statLine.map(s => <span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-sm text-gray-700"><strong class="text-gray-900">{s.n}</strong>{` ${s.label}`}</span>)}
        </div>
      )}
      <div class="mt-5 flex flex-col sm:flex-row gap-x-6 gap-y-2 text-[15px]">
        <a href={`/states/${stateSlug(city.state)}`} class="text-secondary font-semibold">{`Who qualifies in ${stateName} →`}</a>
        {helpCount > 0 && <a href={`/free-expungement-help/${stateSlug(city.state)}`} class="text-secondary font-semibold">{`Free legal help in ${stateName} (${helpCount}) →`}</a>}
      </div>
    </div>
  </section>

  <section class="py-8 md:py-12">
    <div class="container">
      {attorneys.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {sorted.map(attorney => <AttorneyCard attorney={attorney} />)}
        </div>
      ) : (
        <div class="bg-white p-6 rounded-lg border border-gray-200 text-center">
          <p class="text-lg text-gray-700">{`No attorneys are listed in ${cityName} yet. See the ${stateName} page for attorneys elsewhere in the state.`}</p>
        </div>
      )}
      {localHelp.length > 0 && (
        <div class="mt-10 rounded-xl border border-emerald-200 bg-emerald-50 p-6">
          <h2 class="!text-xl !mb-2 font-bold text-emerald-900">{`Free help in ${cityName}`}</h2>
          <p class="text-[15px] text-emerald-900/80 mb-4">{`If you can't afford an attorney, these programmes help people in ${cityName} for free or at low cost. Most have income limits.`}</p>
          <ul class="space-y-3">
            {localHelp.map(o => (
              <li class="rounded-lg bg-white border border-emerald-100 p-4">
                <a href={o.url} target="_blank" rel="noopener noreferrer" data-track="city-help" class="font-semibold text-emerald-900">{o.name}</a>
                {o.who_qualifies && <p class="text-sm text-gray-700 mt-1">{`Who qualifies: ${o.who_qualifies}`}</p>}
                {o.phone && <p class="text-sm text-gray-700 mt-1">{`Phone: ${o.phone}`}</p>}
              </li>
            ))}
          </ul>
          <a href={`/free-expungement-help/${stateSlug(city.state)}`} class="mt-4 inline-block font-semibold text-emerald-900">{`All ${helpCount} free programmes in ${stateName} →`}</a>
        </div>
      )}
      <p class="mt-8 text-sm text-gray-500 max-w-3xl">Labels and summaries come from each firm's own website. Ratings are the firm's public review score. Confirm fees and details with the firm before you hire.</p>
    </div>
  </section>

  {nearbyCitiesWithCounts.length > 0 && (
    <section class="py-12 bg-white border-t border-gray-200">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <h2 class="!text-2xl font-bold mb-6">Other Cities in {stateName}</h2>
          <p class="text-gray-700 mb-6">
            Expungement attorneys in other {stateName} cities:
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {nearbyCitiesWithCounts.map(nearbyCity => (
              <a 
                href={`/cities/${nearbyCity.seoSlug || nearbyCity.slug}`}
                class="flex items-center p-4 bg-white rounded-lg border border-gray-200 hover:shadow-md transition-shadow"
              >
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-4">
                  <span class="text-blue-800 font-bold">{nearbyCity.attorneyCount}</span>
                </div>
                <div>
                  <h3 class="!text-base !mb-0 font-semibold">{`${formatCityName(nearbyCity.name)}, ${nearbyCity.state}`}</h3>
                  <p class="text-sm text-gray-600">{`${nearbyCity.attorneyCount} ${nearbyCity.attorneyCount === 1 ? 'attorney' : 'attorneys'}`}</p>
                </div>
                <div class="ml-auto">
                  <span class="text-secondary">→</span>
                </div>
              </a>
            ))}
          </div>
          
          <div class="mt-8 text-center">
            <a href="/cities" class="btn btn-secondary">
              View All Cities
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
  
  <RelatedGuides state={city.state} />
</PageLayout>
