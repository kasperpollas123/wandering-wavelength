---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import AttorneyCard from '../../components/AttorneyCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CallToAction from '../../components/CallToAction.astro';
import FAQSection from '../../components/FAQSection.astro';
import SchemaMarkup from '../../components/SchemaMarkup.astro';
import { cities, stateNames, stateSlug, stateLawChecked } from '../../data/cities';
import { getAttorneysForCity } from '../../data/attorneys';
import { getHelpForState } from '../../data/freeHelp';

export function getStaticPaths() {
  return cities.filter(city => getAttorneysForCity(city).length > 0).map(city => ({
    params: { slug: city.seoSlug || city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;

// Use the base slug (not SEO slug) for fetching attorneys
const attorneys = getAttorneysForCity(city);
const stateName = stateNames[city.state] || city.state;
const helpCount = getHelpForState(city.state).length;

// Format city name for display (capitalize first letter of each word)
const formatCityName = (name: string) => {
  return name.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
};

const cityName = formatCityName(city.name);

// Concise meta description within 155 characters
const metaDescription = `Attorneys in ${cityName}, ${city.state} who handle expungement and record sealing, with a summary of ${stateNames[city.state] || city.state} law and free legal help options.`;

// Find nearby cities in the same state (excluding current city)
const nearbyCitiesWithCounts = cities
  .filter(c => c.state === city.state && c.slug !== city.slug)
  .map(c => {
    const cityAttorneys = getAttorneysForCity(c);
    return {
      ...c,
      attorneyCount: cityAttorneys.length
    };
  })
  .sort((a, b) => b.attorneyCount - a.attorneyCount) // Sort by attorney count
  .filter(c => c.attorneyCount > 0)
  .slice(0, 8);
---

<PageLayout 
  title={`Expungement Attorneys in ${city.name}, ${city.state} | Record Clearing Lawyers`}
  description={metaDescription}
  canonicalURL={`/cities/${city.seoSlug || city.slug}`}
  schemaType="city"
  schemaData={city}
>
  <!-- Add Schema.org markup for City -->
  <SchemaMarkup type="city" data={city} />
  
  <Hero 
    title={`Find Expungement Attorneys in ${cityName}`}
    subtitle={`Attorneys in ${cityName}, ${city.state} who handle expungement and record sealing.`}
    backgroundImage="/images/hero/p8bsykcxvdrme0cn7wer7hzwfm.webp"
  />
  
  <div class="container py-8">
    <Breadcrumbs 
      items={[
        { label: stateName, href: `/states/${stateSlug(city.state)}` },
        { label: `${cityName}, ${city.state}` }
      ]}
    />
  </div>
  
  <section class="py-12 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto mb-12">
        <h2 class="text-3xl font-bold mb-6">About {cityName}, {city.state}</h2>
        <p class="text-lg text-gray-700 mb-6">This page lists {`${attorneys.length} ${attorneys.length === 1 ? 'attorney' : 'attorneys'}`} in {cityName}, {stateName} who handle expungement and record sealing cases, with their address, phone number and website. Record clearing is governed by state law, so the rules below apply across {stateName}.</p>
        
        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
          <h3 class="text-xl font-semibold mb-4">Expungement Laws in {stateName}</h3>
          <p class="text-gray-700 mb-4">
            {city.expungementInfo ? 
              city.expungementInfo : 
              `Expungement laws vary by state, and ${city.state} has specific requirements and procedures for clearing criminal records. An experienced expungement attorney can help you navigate these laws and determine your eligibility.`
            }
          </p>
          <p class="text-sm text-gray-500 mb-4">A general summary, not legal advice. Last checked {stateLawChecked}.</p>
          <a href={`/states/${stateSlug(city.state)}`} class="text-primary hover:underline font-medium">
            More about expungement in {stateName} and attorneys elsewhere in the state →
          </a>
          {helpCount > 0 && (
            <a href={`/free-expungement-help/${stateSlug(city.state)}`} class="block mt-3 text-primary hover:underline font-medium">
              Free and low-cost help in {stateName}: {helpCount} legal aid and clinic programmes →
            </a>
          )}
        </div>
      </div>
      
      <div class="mb-12">
        <h2 class="text-3xl font-bold mb-6">Expungement Attorneys in {cityName}</h2>
        
        {attorneys.length > 0 ? (
          <div class="space-y-8">
            {attorneys.map(attorney => (
              <AttorneyCard
                name={attorney.name}
                image={attorney.image}
                rating={attorney.rating}
                reviewCount={attorney.reviewCount}
                specialty={attorney.specialty}
                description={attorney.description}
                phone={attorney.phone}
                website={attorney.website}
                address={attorney.address}
                slug={attorney.slug}
                city={cityName}
              />
            ))}
          </div>
        ) : (
          <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 text-center">
            <p class="text-lg text-gray-700">
              We're currently updating our database of expungement attorneys in {cityName}. 
              Please check back soon or contact us for recommendations.
            </p>
          </div>
        )}
      </div>
      
    </div>
  </section>
  
  {nearbyCitiesWithCounts.length > 0 && (
    <section class="py-12 bg-gray-50">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold mb-6">Other Cities in {stateName}</h2>
          <p class="text-gray-700 mb-6">
            Expungement attorneys in other {stateName} cities:
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {nearbyCitiesWithCounts.map(nearbyCity => (
              <a 
                href={`/cities/${nearbyCity.seoSlug || nearbyCity.slug}`}
                class="flex items-center p-4 bg-white rounded-lg border border-gray-200 hover:shadow-md transition-shadow"
              >
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-4">
                  <span class="text-blue-800 font-bold">{nearbyCity.attorneyCount}</span>
                </div>
                <div>
                  <h3 class="font-semibold">{formatCityName(nearbyCity.name)}, {nearbyCity.state}</h3>
                  <p class="text-sm text-gray-600">{nearbyCity.attorneyCount} Expungement Attorneys</p>
                </div>
                <div class="ml-auto">
                  <span class="text-secondary">→</span>
                </div>
              </a>
            ))}
          </div>
          
          <div class="mt-8 text-center">
            <a href="/cities" class="btn btn-secondary">
              View All Cities
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
  
  <FAQSection limit={3} />
  
  <CallToAction 
    title={`Ready to Clear Your Record in ${cityName}?`}
    description="Connect with an experienced expungement attorney today to learn about your options and start the process of clearing your criminal record."
    buttonText="Contact an Attorney Now"
  />
</PageLayout>
