---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SchemaMarkup from '../../components/SchemaMarkup.astro';
import { attorneys, getCityForAttorney } from '../../data/attorneys';
import { stateNames, stateSlug } from '../../data/cities';
import { getHelpForState } from '../../data/freeHelp';
import { badges, BADGE_CLASS, serviceLabels, initials, hasPhoto, telHref, prettyPhone, prettyHost, otherLanguages, listingOrder } from '../../data/attorneyFacts';

export function getStaticPaths() {
  return attorneys.map(attorney => ({
    params: { slug: attorney.slug },
    props: { attorney }
  }));
}

const { attorney } = Astro.props;
const city = getCityForAttorney(attorney);
const stateName = stateNames[attorney.state] || attorney.state;
const hasStatePage = Boolean(stateNames[attorney.state]);
const helpCount = hasStatePage ? getHelpForState(attorney.state).length : 0;

const profile = attorney.profile;
const rcPage = attorney.rcPage;
const tags = badges(attorney);
const services = serviceLabels(attorney, 12);
const photo = hasPhoto(attorney);
const hasWebsite = attorney.website && attorney.website !== '#';
const langs = otherLanguages(attorney);
const otherAreas = profile?.other_practice_areas || [];
const people = profile?.attorneys || [];

// "Fees and consultations": only what the firm states
const feeFacts = [
  profile?.free_consultation === true && 'The first consultation is free.',
  profile?.fees,
  profile?.payment_plans === true && 'Payment plans are available.',
].filter(Boolean) as string[];
const goodToKnow = [
  profile?.founded_or_experience,
  profile?.areas_served && `Areas served: ${profile.areas_served}`,
  langs.length > 0 && `Languages: English, ${langs.join(', ')}`,
].filter(Boolean) as string[];

const metaDescription = (profile?.description.split('\n')[0] || `${attorney.name} is a law firm in ${attorney.city}, ${stateName} listed for expungement and record sealing.`).slice(0, 155);

const cityLabel = attorney.city || city?.name || '';
const relatedAttorneys = attorneys
  .filter(a => a.citySlug === attorney.citySlug && a.state === attorney.state && a.slug !== attorney.slug)
  .sort(listingOrder)
  .slice(0, 4);

const H2 = '!text-xl !mb-3 font-bold text-gray-900 flex items-center gap-2';
---

<PageLayout
  title={`${attorney.name} - Expungement Attorney in ${attorney.city}, ${attorney.state}`}
  description={metaDescription}
  canonicalURL={`/attorneys/${attorney.slug}`}
  schemaType="attorney"
  schemaData={attorney}
>
  <SchemaMarkup type="attorney" data={attorney} />

  <!-- Header: who, where, and how to reach them, all on the first screen -->
  <section class="bg-white border-b border-gray-200">
    <div class="container pt-6 pb-8">
      <Breadcrumbs
        items={[
          ...(hasStatePage ? [{ label: stateName, href: `/states/${stateSlug(attorney.state)}` }] : [{ label: "Cities", href: "/cities" }]),
          ...(city ? [{ label: `${city.name}, ${city.state}`, href: `/cities/${city.seoSlug || city.slug}` }] : []),
          { label: attorney.name }
        ]}
      />
      <div class="mt-4 grid gap-6 lg:grid-cols-5 lg:items-start">
        <div class="lg:col-span-3">
          <h1 class="!text-3xl md:!text-4xl !mb-2">{attorney.name}</h1>
          <p class="text-lg text-gray-600">{`Expungement and record sealing · ${attorney.city}, ${attorney.state}`}</p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            {attorney.reviewCount > 0 && (
              <span class="inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-sm font-semibold text-amber-900">
                <svg class="h-3.5 w-3.5 text-amber-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.29a1 1 0 00.95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 00-.36 1.12l1.07 3.29c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 00-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.29a1 1 0 00-.36-1.12L2.07 8.72c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 00.95-.69l1.07-3.29z"/></svg>
                {attorney.rating}<span class="font-normal text-amber-800">{` · ${attorney.reviewCount} reviews`}</span>
              </span>
            )}
            {tags.map(t => <span class={`rounded-full border px-2.5 py-0.5 text-xs font-medium ${BADGE_CLASS[t.tone]}`}>{t.label}</span>)}
          </div>

          <div class="mt-5 grid gap-2 sm:flex sm:gap-3">
            {attorney.phone && <a href={telHref(attorney.phone)} data-track="top" class="btn btn-primary !py-3 !shadow-sm hover:!translate-y-0 sm:px-8">{`Call ${prettyPhone(attorney.phone)}`}</a>}
            {hasWebsite && <a href={attorney.website} target="_blank" rel="noopener noreferrer" data-track="top" class="btn bg-white text-gray-800 border-gray-300 !py-3 !shadow-none hover:!translate-y-0 hover:bg-gray-50 sm:px-8">Visit website</a>}
          </div>

          <ul class="mt-5 space-y-2 text-[15px] text-gray-700">
            {attorney.address && (
              <li class="flex gap-2"><svg class="h-5 w-5 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.66 16.66L13.41 20.9a2 2 0 01-2.83 0l-4.24-4.24a8 8 0 1111.32 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg><span>{attorney.address}</span></li>
            )}
            {hasWebsite && (
              <li class="flex gap-2"><svg class="h-5 w-5 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg><a href={attorney.website} target="_blank" rel="noopener noreferrer" data-track="contact" class="text-secondary break-all">{prettyHost(attorney.website)}</a></li>
            )}
          </ul>
        </div>

        <div class="lg:col-span-2">
          {photo ? (
            <img src={attorney.image} alt={attorney.name} class="w-full h-56 lg:h-72 object-cover rounded-xl bg-slate-100 border border-gray-200" loading="eager" fetchpriority="high" width="480" height="288" decoding="async"
              onerror="this.onerror=null; this.style.display='none';" />
          ) : (
            <div class="hidden lg:flex h-72 items-center justify-center rounded-xl border border-gray-200 bg-gradient-to-br from-slate-100 to-blue-50">
              <span class="w-24 h-24 rounded-full bg-white border border-blue-100 flex items-center justify-center text-3xl font-bold text-secondary">{initials(attorney.name)}</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Details in separate cards, like the adult day care center pages -->
  <section class="py-8 md:py-12">
    <div class="container grid gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-6">
        <div class="bg-white rounded-xl border border-gray-200 p-6">
          <h2 class={H2}>About the firm</h2>
          {profile ? (
            <div>
              {profile.description.split('\n').filter(p => p.trim()).map(p => <p class="text-[17px] leading-relaxed text-gray-700 mb-4">{p}</p>)}
              {hasWebsite && <p class="text-sm text-gray-500">{'Based on the firm\'s own website, '}<a href={attorney.website} target="_blank" rel="noopener noreferrer" class="underline">{prettyHost(attorney.website)}</a>. Confirm details with the firm.</p>}
            </div>
          ) : (
            <p class="text-[17px] text-gray-700">{`${attorney.name} is a law firm in ${attorney.city}, ${stateName}, listed here for expungement and record sealing. Ask the firm about its services and fees.`}</p>
          )}
        </div>

        {(services.length > 0 || rcPage || attorney.reviewEvidence) && (
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h2 class={H2}>Records they clear</h2>
            {services.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {services.map(s => <span class="rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-sm text-blue-900">{s}</span>)}
              </div>
            )}
            {rcPage && <p class="mt-4 text-[15px] text-gray-700">{'The firm\'s page on this: '}<a href={rcPage.url} target="_blank" rel="noopener noreferrer" data-track="rc-page" class="text-secondary">{rcPage.title || prettyHost(rcPage.url)}</a></p>}
            {attorney.reviewEvidence && services.length === 0 && !rcPage && (
              <p class="text-[15px] text-gray-700">{`Client reviews of ${attorney.name} describe expungement or record sealing work. The firm's website does not have a page about it, so ask whether it takes your kind of case.`}</p>
            )}
          </div>
        )}

        {otherAreas.length > 0 && (
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h2 class={H2}>Other practice areas</h2>
            <div class="flex flex-wrap gap-2">
              {otherAreas.map(area => <span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-sm text-gray-700">{area}</span>)}
            </div>
          </div>
        )}
      </div>

      <aside class="space-y-6">
        <div class="bg-white rounded-xl border border-gray-200 p-6">
          <h2 class={H2}>Fees and consultations</h2>
          {feeFacts.length > 0 ? (
            <ul class="space-y-2 text-[15px] text-gray-700">
              {feeFacts.map(f => <li class="flex gap-2"><svg class="h-5 w-5 shrink-0 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>{f}</span></li>)}
            </ul>
          ) : (
            <p class="text-[15px] text-gray-700">The firm does not publish its fees. Ask about the cost when you call.</p>
          )}
        </div>

        {(goodToKnow.length > 0 || people.length > 0) && (
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h2 class={H2}>Good to know</h2>
            <ul class="space-y-2 text-[15px] text-gray-700">
              {goodToKnow.map(f => <li>{f}</li>)}
              {people.length > 0 && <li>{`Attorneys: ${people.join(', ')}`}</li>}
            </ul>
          </div>
        )}

        {hasStatePage && (
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h2 class={H2}>{`Clearing a record in ${stateName}`}</h2>
            <p class="text-[15px] text-gray-700 mb-3">What can be cleared, how long you wait, and what the process is called in this state.</p>
            <a href={`/states/${stateSlug(attorney.state)}`} class="block text-secondary font-semibold">{`${stateName} rules →`}</a>
            {helpCount > 0 && <a href={`/free-expungement-help/${stateSlug(attorney.state)}`} class="block mt-2 text-secondary font-semibold">{`Free legal help in ${stateName} →`}</a>}
          </div>
        )}
      </aside>
    </div>
  </section>

  {relatedAttorneys.length > 0 && (
    <section class="py-10 bg-white border-t border-gray-200">
      <div class="container">
        <h2 class="!text-2xl !mb-6 font-bold">{`Other expungement attorneys in ${cityLabel}`}</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {relatedAttorneys.map(r => {
            const rt = badges(r).slice(0, 2);
            return (
              <a href={`/attorneys/${r.slug}`} class="flex gap-4 items-center rounded-xl border border-gray-200 bg-white p-4 hover:border-secondary transition-colors">
                {hasPhoto(r) ? (
                  <img src={r.image} alt="" class="h-16 w-16 shrink-0 rounded-lg object-cover bg-slate-100" loading="lazy" decoding="async" width="64" height="64" />
                ) : (
                  <span class="h-16 w-16 shrink-0 rounded-lg bg-gradient-to-br from-slate-100 to-blue-50 flex items-center justify-center font-bold text-secondary">{initials(r.name)}</span>
                )}
                <span class="min-w-0">
                  <span class="block font-semibold text-gray-900 leading-snug">{r.name}</span>
                  {r.reviewCount > 0 && <span class="block text-sm text-gray-600">{`★ ${r.rating} · ${r.reviewCount} reviews`}</span>}
                  {rt.length > 0 && <span class="mt-1 flex flex-wrap gap-1">{rt.map(t => <span class={`rounded-full border px-2 py-0.5 text-[11px] font-medium ${BADGE_CLASS[t.tone]}`}>{t.label}</span>)}</span>}
                </span>
              </a>
            );
          })}
        </div>
        {city && (
          <a href={`/cities/${city.seoSlug || city.slug}`} class="mt-6 inline-block text-secondary font-semibold">{`All attorneys in ${city.name} →`}</a>
        )}
      </div>
    </section>
  )}
</PageLayout>
