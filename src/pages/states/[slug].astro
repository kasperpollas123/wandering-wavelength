---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CallToAction from '../../components/CallToAction.astro';
import { cities, stateNames, stateSlug, stateExpungementInfo } from '../../data/cities';
import { getAttorneysByState, getAttorneysForCity, getCityForAttorney } from '../../data/attorneys';
import { getHelpForState } from '../../data/freeHelp';

// One page for every state that has at least one attorney in the directory
export function getStaticPaths() {
  return Object.keys(stateNames)
    .filter(code => getAttorneysByState(code).length > 0)
    .map(code => ({ params: { slug: stateSlug(code) }, props: { code } }));
}

const { code } = Astro.props;
const stateName = stateNames[code];
const attorneys = getAttorneysByState(code).sort((a, b) => a.city.localeCompare(b.city) || a.name.localeCompare(b.name));
const lawInfo = stateExpungementInfo[code];
const helpCount = getHelpForState(code).length;

// City pages in this state
const stateCities = cities
  .filter(c => c.state === code)
  .map(c => ({ ...c, attorneyCount: getAttorneysForCity(c).length }))
  .filter(c => c.attorneyCount > 0)
  .sort((a, b) => b.attorneyCount - a.attorneyCount || a.name.localeCompare(b.name));

// Attorneys in towns that have no city page of their own, grouped by town
const withoutCityPage = attorneys.filter(a => !getCityForAttorney(a));
const byTown = withoutCityPage.reduce((acc, a) => {
  (acc[a.city] = acc[a.city] || []).push(a);
  return acc;
}, {} as Record<string, typeof attorneys>);
const towns = Object.keys(byTown).sort();

const title = `Expungement Attorneys in ${stateName} | Record Clearing Lawyers by City`;
const description = `${attorneys.length} attorneys in ${stateName} who handle expungement and record sealing, listed by city, with a summary of ${stateName}'s expungement law.`;
---

<PageLayout title={title} description={description} canonicalURL={`/states/${stateSlug(code)}`}>
  <Hero
    title={`Expungement Attorneys in ${stateName}`}
    subtitle={`${attorneys.length} attorneys who handle expungement and record sealing in ${stateName}, listed by city.`}
    backgroundImage="/images/hero/p8bsykcxvdrme0cn7wer7hzwfm.webp"
  />

  <div class="container py-8">
    <Breadcrumbs items={[{ label: "States", href: "/states" }, { label: stateName }]} />
  </div>

  <section class="py-12 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        {lawInfo && (
          <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 mb-12">
            <h2 class="text-2xl font-bold mb-4">Expungement Law in {stateName}</h2>
            <p class="text-gray-700 mb-4">{lawInfo}</p>
            <p class="text-sm text-gray-500">
              This is a general summary, not legal advice. Laws change, and eligibility depends on the details of a case. An attorney in {stateName} can confirm what applies to you.
            </p>
          </div>
        )}

        {helpCount > 0 && (
          <a href={`/free-expungement-help/${stateSlug(code)}`} class="block p-6 mb-12 rounded-lg border border-gray-200 hover:shadow-md transition-shadow">
            <h2 class="text-xl font-semibold mb-1">Free and Low-Cost Help in {stateName} →</h2>
            <p class="text-gray-700">{helpCount} legal aid offices, law school clinics and other programmes, with who qualifies for each.</p>
          </a>
        )}

        {stateCities.length > 0 && (
          <div class="mb-12">
            <h2 class="text-2xl font-bold mb-6">{stateName} Cities</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {stateCities.map(c => (
                <a href={`/cities/${c.seoSlug || c.slug}`} class="flex items-center p-4 bg-white rounded-lg border border-gray-200 hover:shadow-md transition-shadow">
                  <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mr-4">
                    <span class="text-blue-800 font-bold">{c.attorneyCount}</span>
                  </div>
                  <div>
                    <h3 class="font-semibold">{c.name}, {c.state}</h3>
                    <p class="text-sm text-gray-600">{c.attorneyCount} expungement {c.attorneyCount === 1 ? 'attorney' : 'attorneys'}</p>
                  </div>
                  <div class="ml-auto"><span class="text-secondary">→</span></div>
                </a>
              ))}
            </div>
          </div>
        )}

        {towns.length > 0 && (
          <div class="mb-12">
            <h2 class="text-2xl font-bold mb-6">{stateCities.length > 0 ? `Attorneys Elsewhere in ${stateName}` : `Expungement Attorneys in ${stateName}`}</h2>
            <div class="space-y-6">
              {towns.map(town => (
                <div>
                  <h3 class="text-lg font-semibold mb-2">{town}</h3>
                  <ul class="space-y-2">
                    {byTown[town].map(a => (
                      <li class="p-4 bg-gray-50 rounded-lg border border-gray-200">
                        <a href={`/attorneys/${a.slug}`} class="font-medium text-primary hover:underline">{a.name}</a>
                        <p class="text-sm text-gray-600">
                          {a.address}{a.phone && ` · ${a.phone}`}{a.reviewCount > 0 && ` · ${a.rating} on Google (${a.reviewCount} reviews)`}
                        </p>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        )}

        <div class="text-center">
          <a href="/states" class="btn btn-secondary">All States</a>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title={`Ready to Clear Your Record in ${stateName}?`}
    description="Contact an attorney to find out whether your record qualifies and what the process involves."
    buttonText="Browse Cities"
  />
</PageLayout>
