---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { guideTopics } from '../../data/guides';
import articles from '../../data/articles.json';
---

<PageLayout
  title="Guides to Criminal Records and Clearing Them"
  description="Plain-English guides: how long a DUI, misdemeanor or felony stays on your record, restoring gun rights, eviction records and background check errors."
  canonicalURL="/guides"
>
  <div class="container py-8 mt-8">
    <Breadcrumbs items={[{ label: "Guides" }]} />
  </div>
  <section class="pb-12 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold mb-6">Guides</h1>
        <p class="text-lg text-gray-700 mb-8">Plain-English answers to common questions about criminal records, checked state by state against official sources.</p>
        <div class="space-y-4">
          <a href="/guides/expungement-cost-by-state" class="block p-6 rounded-lg border border-gray-200 hover:shadow-md transition-shadow">
            <h2 class="text-xl font-semibold mb-1">How Much Does an Expungement Cost? Fees in Every State</h2>
            <p class="text-gray-700">Court and state fees to clear a record in all 50 states and DC, fee waivers, and where records clear automatically for free.</p>
          </a>
          {guideTopics.map(t => (
            <a href={`/guides/${t.slug}`} class="block p-6 rounded-lg border border-gray-200 hover:shadow-md transition-shadow">
              <h2 class="text-xl font-semibold mb-1">{t.title}</h2>
              <p class="text-gray-700">{t.description}</p>
            </a>
          ))}
          {(articles as any[]).map(a => (
            <a href={`/guides/${a.slug}`} class="block p-6 rounded-lg border border-gray-200 hover:shadow-md transition-shadow">
              <h2 class="text-xl font-semibold mb-1">{a.title}</h2>
              <p class="text-gray-700">{a.description}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</PageLayout>
