---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { stateSlug } from '../../data/cities';
import { guideTopics, factStates, factsChecked, clearableLabel } from '../../data/guides';
import { getAttorneysByState } from '../../data/attorneys';
import { getHelpForState } from '../../data/freeHelp';

export function getStaticPaths() {
  return guideTopics.map(topic => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const rows = factStates.map(s => ({ ...s, fact: s.facts[topic.key] }));
const count = (v: string) => rows.filter(r => r.fact.clearable === v).length;
const badge: Record<string, string> = {
  yes: 'bg-green-100 text-green-900', some: 'bg-yellow-100 text-yellow-900', no: 'bg-red-100 text-red-900', unclear: 'bg-gray-100 text-gray-700'
};
const hostOf = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const others = guideTopics.filter(t => t.slug !== topic.slug);
---

<PageLayout title={topic.title} description={topic.description} canonicalURL={`/guides/${topic.slug}`}>
  <div class="container py-8 mt-8">
    <Breadcrumbs items={[{ label: "Guides", href: "/guides" }, { label: `${topic.short} on your record` }]} />
  </div>

  <section class="pb-12 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold mb-6">{topic.title}</h1>
        {topic.intro.map(p => <p class="text-lg text-gray-700 mb-4">{p}</p>)}

        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 my-8">
          <h2 class="text-xl font-semibold mb-3">The short answer</h2>
          <p class="text-gray-700 mb-2">{`Can ${topic.noun} conviction be cleared from a criminal record?`}</p>
          <ul class="text-gray-700 space-y-1">
            <li>{`Yes in ${count('yes')} states`}</li>
            <li>{`In some cases in ${count('some')} states`}</li>
            <li>{`No in ${count('no')} states`}</li>
          </ul>
          <p class="text-sm text-gray-500 mt-3">{`Researched and written by the Expungement Attorneys Directory editors. Counts include the District of Columbia. Checked ${factsChecked} against state statutes, courts and agencies. This is general information, not legal advice; laws change and the details of a case matter. `}<a href="/about" class="underline">How we research</a></p>
        </div>

        <h2 class="text-2xl font-bold mb-4">Every state at a glance</h2>
        <div class="overflow-x-auto mb-12">
          <table class="w-full text-left text-sm border border-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="p-3 border-b border-gray-200">State</th>
                <th class="p-3 border-b border-gray-200">Can it be cleared?</th>
                <th class="p-3 border-b border-gray-200">Waiting period</th>
              </tr>
            </thead>
            <tbody>
              {rows.map(r => (
                <tr class="border-b border-gray-100 align-top">
                  <td class="p-3 font-medium whitespace-nowrap"><a href={`#${stateSlug(r.code)}`} class="text-primary hover:underline">{r.name}</a></td>
                  <td class="p-3"><span class={`inline-block px-2 py-1 rounded text-xs font-medium whitespace-nowrap ${badge[r.fact.clearable]}`}>{clearableLabel[r.fact.clearable]}</span></td>
                  <td class="p-3 text-gray-700">{r.fact.wait || (r.fact.clearable === 'no' ? 'Not applicable' : 'See below')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="text-2xl font-bold mb-6">State by state</h2>
        <div class="space-y-8">
          {rows.map(r => (
            <div id={stateSlug(r.code)} class="p-6 bg-gray-50 rounded-lg border border-gray-200 scroll-mt-24">
              <h3 class="text-xl font-semibold mb-3">{`${topic.short} on your record in ${r.name}`}</h3>
              <p class="text-gray-700 mb-2"><span class="font-medium">Can it be cleared:</span>{` ${clearableLabel[r.fact.clearable]}${r.facts.remedy_name ? ` (${r.name} calls it ${r.facts.remedy_name})` : ''}.`}</p>
              {r.fact.wait && <p class="text-gray-700 mb-2"><span class="font-medium">Waiting period:</span>{` ${r.fact.wait}`}</p>}
              {r.fact.note && <p class="text-gray-700 mb-2">{r.fact.note}</p>}
              {topic.key === 'dui' && r.facts.dui_driving_record && (
                <p class="text-gray-700 mb-2"><span class="font-medium">Driving record:</span>{` ${r.facts.dui_driving_record}`}</p>
              )}
              {r.facts.automatic && <p class="text-gray-700 mb-2"><span class="font-medium">Automatic clearing:</span>{` ${r.facts.automatic}`}</p>}
              <p class="text-sm mt-3">
                <a href={`/states/${stateSlug(r.code)}`} class="text-primary hover:underline font-medium">{`${r.name} expungement law and attorneys`}</a>
                {getHelpForState(r.code).length > 0 && <span>{' · '}<a href={`/free-expungement-help/${stateSlug(r.code)}`} class="text-primary hover:underline font-medium">{`Free legal help in ${r.name}`}</a></span>}
              </p>
              {r.facts.sources.length > 0 && (
                <p class="text-xs text-gray-500 mt-2">Sources: {r.facts.sources.map((u, i) => (
                  <span>{i > 0 && ', '}<a href={u} target="_blank" rel="noopener noreferrer" class="underline">{hostOf(u)}</a></span>
                ))}</p>
              )}
            </div>
          ))}
        </div>

        <div class="mt-12 p-6 rounded-lg border border-gray-200">
          <h2 class="text-xl font-semibold mb-3">Related guides</h2>
          <ul class="space-y-2">
            {others.map(t => <li><a href={`/guides/${t.slug}`} class="text-primary hover:underline">{t.title}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
